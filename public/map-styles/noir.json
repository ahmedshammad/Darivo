{
  "version": 8,
  "name": "Darivo Noir",
  "metadata": {
    "darivo:author": "Darivo Studio",
    "darivo:geography": "OpenStreetMap / OpenMapTiles via OpenFreeMap"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org/\">OpenFreeMap</a> · <a href=\"https://openmaptiles.org/\">OpenMapTiles</a> · <a href=\"https://www.openstreetmap.org/copyright\">© OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#202124"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#292c29",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#111215"
      }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "minzoom": 7,
      "paint": {
        "line-color": "#777267",
        "line-opacity": 0.55,
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 13, 1]
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#0B0B0C",
        "line-width": 1.3
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#666056",
        "line-width": 0.7,
        "line-opacity": 0.5
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"],
        true,
        false
      ],
      "paint": {
        "line-color": "#5a554d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 13, 1.3, 17, 4],
        "line-opacity": 0.8
      }
    },
    {
      "id": "building-footprints",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#3b3936"
      }
    },
    {
      "id": "buildings",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#555047",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 3],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.7
      }
    },
    {
      "id": "label-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 1,
      "maxzoom": 6,
      "filter": ["match", ["get", "class"], ["country"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 13,
        "text-max-width": 8,
        "text-padding": 12,
        "text-letter-spacing": 0.04
      },
      "paint": {
        "text-color": "#c9c2b7",
        "text-halo-color": "#202124",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 4,
      "maxzoom": 24,
      "filter": ["match", ["get", "class"], ["city", "town"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 13, 10, 15],
        "text-max-width": 8,
        "text-padding": 8,
        "text-letter-spacing": 0.04
      },
      "paint": {
        "text-color": "#c9c2b7",
        "text-halo-color": "#202124",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "maxzoom": 24,
      "filter": [
        "match",
        ["get", "class"],
        ["suburb", "quarter", "neighbourhood", "village"],
        true,
        false
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 12, 13, 14],
        "text-max-width": 8,
        "text-padding": 5,
        "text-letter-spacing": 0.04,
        "symbol-sort-key": ["coalesce", ["get", "rank"], 100]
      },
      "paint": {
        "text-color": "#e0d8ca",
        "text-halo-color": "#202124",
        "text-halo-width": 1.5
      }
    }
  ]
}

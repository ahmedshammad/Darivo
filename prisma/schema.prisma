generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  VERIFIED_CLIENT
  DEVELOPER_PARTNER
  ADVISOR
  ADMIN
}

enum Visibility {
  PUBLIC
  VERIFIED_ONLY
  PRIVATE_INVITE
}

enum Verification {
  UNVERIFIED
  PENDING
  VERIFIED
}

model User {
  id            String                   @id @default(cuid())
  name          String?
  email         String                   @unique
  emailVerified DateTime?
  image         String?
  role          Role                     @default(CLIENT)
  verification  Verification             @default(UNVERIFIED)
  createdAt     DateTime                 @default(now())
  accounts      Account[]
  sessions      Session[]
  profile       ClientProfile?
  advisor       Advisor?
  shortlists    Shortlist[]
  viewings      ViewingRequest[]
  brief         ClientBrief?
  conversations ConsultantConversation[]
  grants        OffMarketGrant[]
  handoffs      Handoff[]
  notes         AdvisorNote[]            @relation("ClientNotes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ClientProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  language          String    @default("en")
  currency          String    @default("AED")
  areaUnit          String    @default("sqm")
  timezone          String    @default("Asia/Dubai")
  notifications     Boolean   @default(false)
  arabicIndicDigits Boolean   @default(false)
  consentAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Advisor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Country {
  id     String @id
  nameEn String
  nameAr String
  cities City[]
}

model City {
  id          String      @id
  countryId   String
  nameEn      String
  nameAr      String
  country     Country     @relation(fields: [countryId], references: [id])
  communities Community[]
}

model Community {
  id         String       @id
  cityId     String
  nameEn     String
  nameAr     String
  lat        Float
  lng        Float
  city       City         @relation(fields: [cityId], references: [id])
  properties Property[]
  insight    AreaInsight?
  demoPois   DemoPOI[]
}

enum DeveloperKind {
  REAL_REFERENCE
  DEMO
  AGGREGATE
}

enum ProjectKind {
  REAL_REFERENCE
  DEMO
}

enum DatePrecision {
  UNKNOWN
  YEAR
  MONTH
  DAY
}

enum SourceBasis {
  UNKNOWN
  AGENT_LISTING
  LISTING
  BROKER_PROJECT_PAGE
  PORTAL_PROJECT_PAGE
  PRESS_REPORT
  DEMO_ESTIMATE
}

enum SourceConfidence {
  UNASSESSED
  LOW
  MEDIUM
  HIGH
}

model Developer {
  id            String          @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  kind          DeveloperKind   @default(DEMO)
  country       String?
  knownFor      String[]        @default([])
  rawReference  Json?
  projects      Project[]
  facts         ReferenceFact[]
  properties    Property[]
}

model Property {
  id                 String                     @id @default(cuid())
  slug               String                     @unique
  communityId        String
  developerId        String
  // The write trigger assigns a fictional project for legacy admin creates.
  // A DB check guarantees persisted units always have a project.
  projectId          String?
  project            Project?                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  type               String
  status             String
  handoverDate       DateTime?
  bedrooms           Int
  bathrooms          Int
  areaSqm            Float
  plotSqm            Float?
  priceMinor         BigInt
  currency           String
  priceAed           Float
  serviceChargeMinor Int
  view               String
  furnishing         String
  amenities          String[]
  branded            Boolean                    @default(false)
  visibility         Visibility                 @default(PUBLIC)
  verification       Verification               @default(VERIFIED)
  permitNumber       String
  lastVerifiedAt     DateTime
  lat                Float
  lng                Float
  embedding          Unsupported("vector(64)")?
  embeddingSource    String                     @default("mock-hash-v1")
  community          Community                  @relation(fields: [communityId], references: [id])
  developer          Developer                  @relation(fields: [developerId], references: [id])
  translations       PropertyTranslation[]
  media              PropertyMedia[]
  paymentPlan        PaymentPlan?
  shortlistItems     ShortlistItem[]
  grants             OffMarketGrant[]
  viewings           ViewingRequest[]

  @@index([visibility, priceAed])
  @@index([communityId, type, bedrooms])
}

model PropertyTranslation {
  id          String   @id @default(cuid())
  propertyId  String
  locale      String
  title       String
  description String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, locale])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  altEn      String
  altAr      String
  position   Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PaymentPlan {
  id                  String   @id @default(cuid())
  propertyId          String   @unique
  bookingPercent      Int
  constructionPercent Int
  handoverPercent     Int
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model AreaInsight {
  id            String    @id @default(cuid())
  communityId   String    @unique
  averageAedSqm Float
  yieldLow      Float
  yieldHigh     Float
  notesEn       String
  notesAr       String
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model Shortlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShortlistItem[]

  @@unique([userId, name])
}

model ShortlistItem {
  id          String    @id @default(cuid())
  shortlistId String
  propertyId  String
  shortlist   Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, propertyId])
}

model ViewingRequest {
  id         String     @id @default(cuid())
  userId     String
  propertyId String
  slots      DateTime[]
  timezone   String
  mode       String
  status     String     @default("REQUESTED")
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model ClientBrief {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsultantConversation {
  id        String              @id @default(cuid())
  userId    String
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ConsultantMessage[]
}

model ConsultantMessage {
  id             String                 @id @default(cuid())
  conversationId String
  role           String
  content        Json
  createdAt      DateTime               @default(now())
  conversation   ConsultantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model OffMarketGrant {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  grantedBy  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  createdAt DateTime @default(now())
}

model FxRate {
  currency String   @id
  perAed   Float
  asOf     DateTime
}

model Handoff {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdvisorNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  client    User     @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  kind      String
  areaId    String?
  createdAt DateTime @default(now())
}

model Project {
  id                     String           @id
  slug                   String           @unique
  kind                   ProjectKind
  developerId            String
  nameEn                 String
  nameAr                 String?
  country                String
  city                   String
  communityName          String
  communityId            String?
  lat                    Float
  lng                    Float
  coordinatesApproximate Boolean          @default(true)
  types                  String[]         @default([])
  status                 String?
  completion             String?
  priceFromAmount        Decimal?         @db.Decimal(20, 2)
  priceFromCurrency      String?
  priceFromLabel         String?
  priceBasis             SourceBasis      @default(UNKNOWN)
  priceNote              String?
  paymentPlanText        String?
  asOf                   String?
  asOfPrecision          DatePrecision    @default(UNKNOWN)
  confidence             SourceConfidence @default(UNASSESSED)
  rawReference           Json?
  demoPriceBasis         Json?
  developer              Developer        @relation(fields: [developerId], references: [id])
  units                  Property[]
  facts                  ReferenceFact[]

  @@index([kind, country, city])
  @@index([developerId, kind])
}

model Source {
  id                     String           @id
  url                    String
  // Publisher is the original hostname unless the dataset names a publisher.
  publisher              String
  basis                  SourceBasis      @default(UNKNOWN)
  retrievedAt            DateTime?
  retrievedDatePrecision DatePrecision    @default(UNKNOWN)
  confidence             SourceConfidence @default(UNASSESSED)
  facts                  ReferenceFact[]

  @@unique([url, basis])
}

// One fact belongs to exactly one reference record (enforced by DB check).
// Dataset URLs are record-level citations: no finer attribution is invented.
model ReferenceFact {
  id            String           @id
  key           String
  value         Json
  developerId   String?
  projectId     String?
  marketStatId  String?
  asOf          String?
  asOfPrecision DatePrecision    @default(UNKNOWN)
  basis         SourceBasis      @default(UNKNOWN)
  confidence    SourceConfidence @default(UNASSESSED)
  citationScope String           @default("record")
  developer     Developer?       @relation(fields: [developerId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  marketStat    MarketStat?      @relation(fields: [marketStatId], references: [id], onDelete: Cascade)
  sources       Source[]

  @@index([developerId])
  @@index([projectId])
  @@index([marketStatId])
}

model MarketStat {
  id            String          @id
  market        String
  metric        String
  value         String
  detail        String?
  asOf          String?
  asOfPrecision DatePrecision   @default(UNKNOWN)
  rawReference  Json
  facts         ReferenceFact[]
}

model DemoPOI {
  id          String    @id
  communityId String
  nameEn      String
  nameAr      String
  kind        String
  lat         Float
  lng         Float
  isDemo      Boolean   @default(true)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, kind])
}

DATABASE_URL="postgresql://darivo:darivo_local_only@127.0.0.1:55432/darivo"
AUTH_URL="http://localhost:3000"
# Generate a unique secret for any shared environment. Local launcher creates this.
AUTH_SECRET=""
DEMO_MODE="true"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"
DATA_REGION="UAE"
GOLDEN_VISA_AED="2000000"
# external = Docker PostgreSQL; the no-config launcher chooses pglite
LOCAL_DB="external"

OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
PDF_BROWSER_CHANNEL="chrome"
